{
  // 放置天堂・旅人頻道（心跳聊天）——部署步驟見 README.md
  "name": "lineage-heartbeat",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "vars": {
    // 允許連線的遊戲網址（逗號分隔）；localhost 一律允許，方便本機測試
    "ALLOW_ORIGINS": "https://manuialeaso.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lineage-heartbeat",
      // 執行 `npx wrangler d1 create lineage-heartbeat` 後，把它印出的 database_id 貼在這裡
      "database_id": "請貼上 database_id"
    }
  ]
}
